// @contract: C-005
// fan.first_ok all-fail: when EVERY candidate fails, fan.first_ok returns a defined
// Err("fan.first_ok: all candidates failed"), which the effect-main termination
// surfaces as "Error: fan.first_ok: all candidates failed" + exit 1 on BOTH targets.
// NOT a native panic (exit 101) and NOT a wasm unreachable trap (exit 134).
effect fn fail_n(m: String) -> Result[Int, String] = err(m)

effect fn main() -> Unit = {
  let winner = fan.first_ok {
    fail_n("a")
    fail_n("b")
    fail_n("c")
  }!
  println("unreachable: " + int.to_string(winner))
}

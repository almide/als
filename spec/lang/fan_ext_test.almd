// fan.first_ok, fan.settle.
// fan.first_ok is now DETERMINISTIC: it tries thunks in LIST ORDER and returns the
// FIRST Ok as Result[T, String]; if all fail it returns a defined Err. In a test
// block (no auto-unwrap) the binding is the full Result, asserted on `ok(v)`.
effect fn succeed(x: Int) -> Result[Int, String] = ok(x)

effect fn fail(msg: String) -> Result[Int, String] = err(msg)

// ── fan.first_ok — first success in list order wins (deterministic) ──
test "fan.first_ok first success" {
  let result = fan.first_ok {
    succeed(42)
    succeed(99)
  }
  assert_eq(result, ok(42))
}

test "fan.first_ok skips failures" {
  let result = fan.first_ok {
    fail("nope")
    succeed(7)
  }
  assert_eq(result, ok(7))
}

test "fan.first_ok all fail returns a defined error" {
  let result = fan.first_ok {
    fail("a")
    fail("b")
  }
  assert_eq(result, err("fan.first_ok: all candidates failed"))
}

// ── fan.settle — collect all results (a TUPLE of per-arm Results, T2-4) ──
test "fan.settle collects all" {
  let (r1, r2, r3) = fan.settle {
    succeed(1)
    fail("bad")
    succeed(3)
  }
  assert_eq(r1, ok(1))
  assert_eq(r2, err("bad"))
  assert_eq(r3, ok(3))
}

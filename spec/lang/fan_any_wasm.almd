// wasm:enabled
// Locks in `fan.first_ok` over a LITERAL thunk list. On wasm the fan combinators are DETERMINISTIC:
// `fan.first_ok` returns the FIRST candidate that succeeds, in list order (NOT wall-clock fastest).
// The trust-spine desugars it into a per-thunk match chain, avoiding an unrepresentable
// `List[funcref]`. Byte-identical to v0 --target wasm.
//
// The `fan.min_cost` cases this file also carried were removed with the combinator in 0.42.0
// (E027 tombstone); `fan.first_ok` exercises the same literal-thunk-list lowering path.
effect fn okn(n: Int) -> Result[Int, String] = ok(n * 3)

effect fn failing() -> Result[Int, String] = err("boom")

effect fn main() -> Unit = {
  // fan.first_ok: the FIRST Ok in list order wins; if every candidate errs, v0's fixed
  // `fan.first_ok: all candidates failed` message. Inlined into a per-thunk match chain.
  match fan.first_ok {
    failing()
    okn(7)
    okn(99)
  } {
    ok(v) => println("any=" + int.to_string(v)),
    err(e) => println("any_err=" + e),
  }
  match fan.first_ok {
    failing()
    failing()
  } {
    ok(v) => println("any_ok"),
    err(e) => println("all_fail=" + e),
  }
  let got = fan.first_ok {
    failing()
    okn(88)
  }!
  println("unwrap=" + int.to_string(got))
}

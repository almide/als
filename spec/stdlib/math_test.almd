import math

// Comprehensive math module tests
// ── abs ──
test "int.abs" {
  assert_eq(int.abs(-5), 5)
  assert_eq(int.abs(0), 0)
  assert_eq(int.abs(42), 42)
}

// ── min / max ──
test "int.min and max" {
  assert_eq(int.min(3, 7), 3)
  assert_eq(int.max(3, 7), 7)
  assert_eq(int.min(5, 5), 5)
  assert_eq(int.max(-10, -3), -3)
}

// ── pow ──
test "int.pow int" {
  assert_eq(int.pow(2, 10), 1024)
  assert_eq(int.pow(5, 0), 1)
  assert_eq(int.pow(3, 3), 27)
}

test "float.pow float" {
  assert_eq(float.pow(2.0, 10.0), 1024.0)
  assert_eq(float.pow(5.0, 0.0), 1.0)
  assert_eq(float.pow(9.0, 0.5) > 2.99, true)
}

// ── pi / e ──
test "math.pi and e" {
  let pi = math.pi()
  assert(pi > 3.14159 and pi < 3.1416)
  let e = math.e()
  assert(e > 2.71828 and e < 2.71829)
}

// ── sqrt ──
test "math.sqrt" {
  assert_eq(math.sqrt(16.0), 4.0)
  assert_eq(math.sqrt(0.0), 0.0)
  let s = math.sqrt(2.0)
  assert(s > 1.414 and s < 1.415)
}

// ── sin / cos / tan ──
test "math.sin cos tan at zero" {
  assert_eq(math.sin(0.0), 0.0)
  assert_eq(math.cos(0.0), 1.0)
  assert_eq(math.tan(0.0), 0.0)
}

test "math.sin cos pythagorean identity" {
  let x = 1.0
  let s = math.sin(x)
  let c = math.cos(x)
  let sum = s * s + c * c
  assert(sum > 0.999 and sum < 1.001)
}

// ── atan / tanh ──
test "math.atan identities" {
  assert_eq(math.atan(0.0), 0.0)
  // atan(1) = pi/4
  let q = math.atan(1.0) * 4.0
  assert(q > 3.14159265 and q < 3.14159266)
  // odd function
  assert_eq(math.atan(-2.5), 0.0 - math.atan(2.5))
}

test "math.tanh range and identities" {
  assert_eq(math.tanh(0.0), 0.0)
  // saturates to ±1 for |x| > 20
  assert_eq(math.tanh(25.0), 1.0)
  assert_eq(math.tanh(-25.0), -1.0)
  // odd function, strictly inside (-1, 1)
  let t = math.tanh(0.5)
  assert(t > 0.462 and t < 0.463)
  assert_eq(math.tanh(-0.5), 0.0 - t)
}

// ── log / log10 / log2 ──
test "math.log log10 log2" {
  assert_eq(math.log(1.0), 0.0)
  assert_eq(math.log10(100.0), 2.0)
  assert_eq(math.log2(8.0), 3.0)
}

// ── exp ──
test "math.exp" {
  assert_eq(math.exp(0.0), 1.0)
  let r = math.exp(1.0)
  assert(r > 2.718 and r < 2.719)
}

// ── sign ──
test "int.sign" {
  assert_eq(int.sign(42), 1)
  assert_eq(int.sign(-7), -1)
  assert_eq(int.sign(0), 0)
}

// ── fmin / fmax / fpow ──
test "float.min and max" {
  assert_eq(float.min(1.5, 2.5), 1.5)
  assert_eq(float.max(1.5, 2.5), 2.5)
}

test "float.min negative" {
  let a = 0.0 - 1.0
  let b = 0.0 - 2.0
  assert_eq(float.min(a, b), b)
}

test "float.pow exact" {
  assert_eq(float.pow(2.0, 3.0), 8.0)
}

// ── factorial / choose ──
test "math.factorial" {
  assert_eq(math.factorial(0), 1)
  assert_eq(math.factorial(5), 120)
}

test "math.choose" {
  assert_eq(math.choose(5, 2), 10)
  assert_eq(math.choose(10, 0), 1)
}

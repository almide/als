// A JS-host hook declared for the wasm target only: a native binary has
// nothing to run when `main` calls it, so the native check refuses it (C-461)
// instead of building a program that aborts at the call.
@extern(wasm, "js", "js_log")
fn js_log(msg: String) -> Unit

fn main() -> Unit = {
  js_log("hello")
}
